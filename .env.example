# COIN RUSH ISLAND - Production Environment Variables Example
# (Salin file ini menjadi .env.local untuk development lokal)

# URL WebSocket server untuk mode multiplayer (opsional di production)
# Contoh: wss://your-multiplayer-server.railway.app
VITE_WS_SERVER_URL=

